# ═══════════════════════════════════════════════════════════════
# GrowWealth App - Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the actual values

# ─────────────────────────────────────────────────────────────────
# SERVER & CLIENT CONFIG
# ─────────────────────────────────────────────────────────────────
PORT=3000
CLIENT_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────
# DATABASE - MongoDB
# ─────────────────────────────────────────────────────────────────
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
# Get this from: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://test1yash1_db_user:XyWNfiNyB3zbRGeL@cluster.mongodb.net/grow_wealth_db

# ─────────────────────────────────────────────────────────────────
# JWT & SECURITY
# ─────────────────────────────────────────────────────────────────
# Use a strong random string for JWT_SECRET
# Generate one: npx crypto-js generate-key (or use any 32+ char random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
NEXTAUTH_SECRET=your-nextauth-secret-key

# ─────────────────────────────────────────────────────────────────
# EMAIL SERVICE - Resend
# ─────────────────────────────────────────────────────────────────
# Get API key from: https://resend.com/dashboard/api-keys
# Make sure your domain is verified in Resend
RESEND_API_KEY=re_your_resend_api_key_here

# ─────────────────────────────────────────────────────────────────
# GOOGLE OAUTH 2.0
# ─────────────────────────────────────────────────────────────────
# Get these from: https://console.cloud.google.com/
# Follow steps in GOOGLE_OAUTH_SETUP.md in the project root
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─────────────────────────────────────────────────────────────────
# OPTIONAL: NODE ENVIRONMENT
# ─────────────────────────────────────────────────────────────────
NODE_ENV=development
